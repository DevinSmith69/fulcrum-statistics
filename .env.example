# --- runtime switches ---
FULCRUM_BUS=memory            # memory | eventhubs
FULCRUM_LLM=fake              # fake | foundry

# --- Azure Event Hubs (Kafka endpoint, Standard tier) ---
EVENTHUBS_NAMESPACE=evh-fulcrum-xxxx       # bootstrap = <ns>.servicebus.windows.net:9093
EVENTHUBS_CONNECTION_STRING=               # dev only; use managed identity in Azure

# --- Microsoft Foundry ---
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini       # fast model for per-moment agents
FOUNDRY_MODEL_DEPLOYMENT_RECAP=gpt-4o      # optional stronger model for full-time recap

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
