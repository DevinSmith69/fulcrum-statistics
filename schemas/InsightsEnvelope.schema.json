{
  "$defs": {
    "CheckStatus": {
      "enum": [
        "passed",
        "repaired",
        "fallback"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "Explanation": {
      "additionalProperties": false,
      "description": "Moment Analyst output (persona-neutral).",
      "properties": {
        "headline": {
          "maxLength": 90,
          "title": "Headline",
          "type": "string"
        },
        "why_it_matters": {
          "maxLength": 400,
          "title": "Why It Matters",
          "type": "string"
        },
        "tactical_tag": {
          "$ref": "#/$defs/TacticalTag"
        },
        "key_fact_keys": {
          "description": "Fact.key values used \u2014 must exist in the moment's fact pack",
          "items": {
            "type": "string"
          },
          "title": "Key Fact Keys",
          "type": "array"
        }
      },
      "required": [
        "headline",
        "why_it_matters",
        "tactical_tag",
        "key_fact_keys"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "Insight": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "insight_id": {
          "title": "Insight Id",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        },
        "clock_ms": {
          "title": "Clock Ms",
          "type": "integer"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/InsightVariant"
          },
          "title": "Variants",
          "type": "array"
        },
        "check_status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "check_notes": {
          "items": {
            "type": "string"
          },
          "title": "Check Notes",
          "type": "array"
        },
        "agent_trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenTelemetry trace id for the agent run",
          "title": "Agent Trace Id"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "match_id",
        "moment_id",
        "clock_ms",
        "explanation",
        "variants",
        "check_status"
      ],
      "title": "Insight",
      "type": "object"
    },
    "InsightVariant": {
      "additionalProperties": false,
      "properties": {
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "perspective_team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for club_fan variants",
          "title": "Perspective Team Id"
        },
        "perspective_player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for player_lens variants",
          "title": "Perspective Player Id"
        },
        "headline": {
          "maxLength": 90,
          "title": "Headline",
          "type": "string"
        },
        "body": {
          "maxLength": 300,
          "title": "Body",
          "type": "string"
        },
        "commentary_line": {
          "description": "One spoken-style line, <= 25 words",
          "maxLength": 160,
          "title": "Commentary Line",
          "type": "string"
        }
      },
      "required": [
        "persona",
        "headline",
        "body",
        "commentary_line"
      ],
      "title": "InsightVariant",
      "type": "object"
    },
    "OverlayAnchor": {
      "enum": [
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right",
        "bottom_center"
      ],
      "title": "OverlayAnchor",
      "type": "string"
    },
    "OverlayCue": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "moment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moment Id"
        },
        "insight_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insight Id"
        },
        "template": {
          "$ref": "#/$defs/OverlayTemplate"
        },
        "anchor": {
          "$ref": "#/$defs/OverlayAnchor",
          "default": "bottom_left"
        },
        "priority": {
          "description": "5 = interrupt everything (goal)",
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "sync_clock_ms": {
          "description": "Match clock the cue is synced to",
          "title": "Sync Clock Ms",
          "type": "integer"
        },
        "sync_seq": {
          "title": "Sync Seq",
          "type": "integer"
        },
        "show_at_clock_ms": {
          "title": "Show At Clock Ms",
          "type": "integer"
        },
        "duration_ms": {
          "maximum": 30000,
          "minimum": 1000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "perspective_team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perspective Team Id"
        },
        "perspective_player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perspective Player Id"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "stats": {
          "items": {
            "$ref": "#/$defs/OverlayStat"
          },
          "title": "Stats",
          "type": "array"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "agents",
                "producer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who made the cue. None/'agents': a moment cue from the agent team (one per persona). 'producer': a graphic the studio producer requested and put on air (persona-neutral: every viewer gets it)",
          "title": "Origin"
        }
      },
      "required": [
        "match_id",
        "template",
        "priority",
        "sync_clock_ms",
        "sync_seq",
        "show_at_clock_ms",
        "duration_ms",
        "persona",
        "headline"
      ],
      "title": "OverlayCue",
      "type": "object"
    },
    "OverlayStat": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "OverlayStat",
      "type": "object"
    },
    "OverlayTemplate": {
      "enum": [
        "lower_third",
        "stat_card",
        "wp_swing",
        "player_tag",
        "pressure_bar",
        "recap_card"
      ],
      "title": "OverlayTemplate",
      "type": "string"
    },
    "Persona": {
      "enum": [
        "analyst",
        "casual",
        "club_fan",
        "player_lens"
      ],
      "title": "Persona",
      "type": "string"
    },
    "Recap": {
      "additionalProperties": false,
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "key_moment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Key Moment Ids",
          "type": "array"
        },
        "player_of_the_match_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Of The Match Id"
        },
        "check_status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "social_posts": {
          "description": "2-3 short posts (<= 280 chars) to share the result, same persona/language; fact-checked",
          "items": {
            "type": "string"
          },
          "title": "Social Posts",
          "type": "array"
        }
      },
      "required": [
        "match_id",
        "persona",
        "title",
        "summary",
        "key_moment_ids",
        "check_status"
      ],
      "title": "Recap",
      "type": "object"
    },
    "TacticalTag": {
      "enum": [
        "control",
        "chaos",
        "pressure_shift",
        "rhythm",
        "individual_brilliance",
        "set_piece",
        "turning_point"
      ],
      "title": "TacticalTag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Wrapper for the `insights` topic, which carries three message types.\n\nBuild with `InsightsEnvelope.wrap(item)`; `kind` must match the type of `data`.",
  "properties": {
    "kind": {
      "enum": [
        "insight",
        "cue",
        "recap"
      ],
      "title": "Kind",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/Insight"
        },
        {
          "$ref": "#/$defs/OverlayCue"
        },
        {
          "$ref": "#/$defs/Recap"
        }
      ],
      "title": "Data"
    }
  },
  "required": [
    "kind",
    "data"
  ],
  "title": "InsightsEnvelope",
  "type": "object"
}