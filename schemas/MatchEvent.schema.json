{
  "$defs": {
    "BodyPart": {
      "enum": [
        "right_foot",
        "left_foot",
        "head",
        "other"
      ],
      "title": "BodyPart",
      "type": "string"
    },
    "CardAttributes": {
      "additionalProperties": false,
      "properties": {
        "colour": {
          "enum": [
            "yellow",
            "red",
            "second_yellow"
          ],
          "title": "Colour",
          "type": "string"
        },
        "reason": {
          "default": "foul",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "colour"
      ],
      "title": "CardAttributes",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "match_start",
        "period_start",
        "period_end",
        "match_end",
        "kick_off",
        "pass",
        "carry",
        "dribble",
        "shot",
        "goal",
        "save",
        "tackle",
        "interception",
        "ball_recovery",
        "clearance",
        "pressure",
        "possession_change",
        "foul",
        "card",
        "corner",
        "free_kick",
        "throw_in",
        "goal_kick",
        "offside",
        "substitution"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "success",
        "fail",
        "goal",
        "saved",
        "off_target",
        "blocked",
        "woodwork",
        "yellow",
        "red",
        "na"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "PassAttributes": {
      "additionalProperties": false,
      "properties": {
        "length_m": {
          "title": "Length M",
          "type": "number"
        },
        "progressive_m": {
          "description": "Metres gained towards opponent goal (can be negative)",
          "title": "Progressive M",
          "type": "number"
        },
        "height": {
          "default": "ground",
          "enum": [
            "ground",
            "low",
            "high"
          ],
          "title": "Height",
          "type": "string"
        },
        "ball_speed_kmh": {
          "title": "Ball Speed Kmh",
          "type": "number"
        },
        "expected_completion": {
          "description": "Model p(complete) before the pass",
          "maximum": 1,
          "minimum": 0,
          "title": "Expected Completion",
          "type": "number"
        },
        "difficulty": {
          "description": "0 trivial \u2026 10 near-impossible",
          "maximum": 10,
          "minimum": 0,
          "title": "Difficulty",
          "type": "number"
        },
        "line_breaking": {
          "default": false,
          "title": "Line Breaking",
          "type": "boolean"
        },
        "into_box": {
          "default": false,
          "title": "Into Box",
          "type": "boolean"
        },
        "is_cross": {
          "default": false,
          "title": "Is Cross",
          "type": "boolean"
        },
        "is_through_ball": {
          "default": false,
          "title": "Is Through Ball",
          "type": "boolean"
        },
        "recipient_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient Id"
        }
      },
      "required": [
        "length_m",
        "progressive_m",
        "ball_speed_kmh",
        "expected_completion",
        "difficulty"
      ],
      "title": "PassAttributes",
      "type": "object"
    },
    "ShotAttributes": {
      "additionalProperties": false,
      "properties": {
        "distance_m": {
          "title": "Distance M",
          "type": "number"
        },
        "angle_rad": {
          "title": "Angle Rad",
          "type": "number"
        },
        "body_part": {
          "$ref": "#/$defs/BodyPart"
        },
        "xg": {
          "maximum": 1,
          "minimum": 0,
          "title": "Xg",
          "type": "number"
        },
        "shot_speed_kmh": {
          "title": "Shot Speed Kmh",
          "type": "number"
        },
        "on_target": {
          "title": "On Target",
          "type": "boolean"
        },
        "big_chance": {
          "default": false,
          "title": "Big Chance",
          "type": "boolean"
        },
        "situation": {
          "default": "open_play",
          "enum": [
            "open_play",
            "counter",
            "set_piece",
            "penalty",
            "corner"
          ],
          "title": "Situation",
          "type": "string"
        },
        "assist_player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assist Player Id"
        }
      },
      "required": [
        "distance_m",
        "angle_rad",
        "body_part",
        "xg",
        "shot_speed_kmh",
        "on_target"
      ],
      "title": "ShotAttributes",
      "type": "object"
    },
    "SubstitutionAttributes": {
      "additionalProperties": false,
      "properties": {
        "player_off_id": {
          "title": "Player Off Id",
          "type": "string"
        },
        "player_on_id": {
          "title": "Player On Id",
          "type": "string"
        }
      },
      "required": [
        "player_off_id",
        "player_on_id"
      ],
      "title": "SubstitutionAttributes",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "seq": {
      "description": "Strictly increasing per match; consumers must de-dupe on it",
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "period": {
      "maximum": 4,
      "minimum": 1,
      "title": "Period",
      "type": "integer"
    },
    "clock_ms": {
      "minimum": 0,
      "title": "Clock Ms",
      "type": "integer"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "possession_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Increments on every change of possession",
      "title": "Possession Id"
    },
    "x": {
      "anyOf": [
        {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "X"
    },
    "y": {
      "anyOf": [
        {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Y"
    },
    "end_x": {
      "anyOf": [
        {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End X"
    },
    "end_y": {
      "anyOf": [
        {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Y"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome",
      "default": "na"
    },
    "under_pressure": {
      "default": false,
      "title": "Under Pressure",
      "type": "boolean"
    },
    "nearest_opponent_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nearest Opponent M"
    },
    "pass": {
      "anyOf": [
        {
          "$ref": "#/$defs/PassAttributes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShotAttributes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "card": {
      "anyOf": [
        {
          "$ref": "#/$defs/CardAttributes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "substitution": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubstitutionAttributes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "score_home": {
      "default": 0,
      "title": "Score Home",
      "type": "integer"
    },
    "score_away": {
      "default": 0,
      "title": "Score Away",
      "type": "integer"
    },
    "extra": {
      "additionalProperties": true,
      "title": "Extra",
      "type": "object"
    }
  },
  "required": [
    "match_id",
    "seq",
    "period",
    "clock_ms",
    "type"
  ],
  "title": "MatchEvent",
  "type": "object"
}